<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remember...</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: Arial, sans-serif;
            overflow: hidden;
        }
        .loading-text {
            color: #fff;
            font-size: 24px;
            animation: blink 1s infinite;
        }
        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }
        .scare {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            justify-content: center;
            align-items: center;
            background: #000;
            z-index: 9999;
        }
        .scare img {
            max-width: 100%;
            max-height: 100%;
        }
    </style>
</head>
<body>
    <div class="loading-text">Loading...</div>
    <div class="scare" id="scare">
        <div style="text-align: center; color: #fff; font-size: 48px; font-weight: bold;">
            👁️ YOU'VE BEEN PRANKED! 👁️
        </div>
    </div>
    
    <script>
        // Wait 2 seconds then show the scare
        setTimeout(() => {
            document.getElementById('scare').style.display = 'flex';
            // Optional: Play a scary sound (uncomment if you want sound)
            // const audio = new Audio('data:audio/wav;base64,...'); // Add sound if desired
            // audio.play();
        }, 2000);
        
        // Hide scare after 3 seconds
        setTimeout(() => {
            document.getElementById('scare').style.display = 'none';
        }, 5000);
    </script>
</body>
</html>